		{6'd62, 4'd6}: intfont = 8'h08;
		{6'd62, 4'd7}: intfont = 8'h10;
		{6'd62, 4'd8}: intfont = 8'h20;
		{6'd63, 4'd2}: intfont = 8'h38;
		{6'd63, 4'd3}: intfont = 8'h44;
		{6'd63, 4'd4}: intfont = 8'h04;
		{6'd63, 4'd5}: intfont = 8'h08;
		{6'd63, 4'd6}: intfont = 8'h10;
		{6'd63, 4'd8}: intfont = 8'h10;
		default: intfont = 8'h00;
	endcase
endfunction
